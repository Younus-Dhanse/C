#include <stdio.h>

int main()
{
    char str[10], rev[10];
    int i, len = 0;

    printf("Enter a string: ");
    scanf("%s", str);

    for(i = 0; str[i] != '\0'; i++)
    {
        len = i + 1;
    }

    for(i = 0; i < len; i++)
    {
        rev[i] = str[len - i - 1];
    }

    rev[len] = '\0';

    for(i = 0; i < len; i++)
    {
        if(str[i] != rev[i])
        {
            printf("Not Palindrome");
            break;
        }
    }

    if(i == len)
        printf("Palindrome");
}
